# Gemini proxy settings. Copy to .env (git-ignored) and fill in. Never commit real values.
# Load before starting:  set -a; . ./.env; set +a; python3 gemini_proxy.py

# Required. From Google AI Studio. Gemini 4 Carbon needs the paid tier.
GEMINI_API_KEY=replace-me

# Model the app uses when it does not name one. Verified on 14 Nov 2026 against
# https://aistudio.google.com/docs/models : gemini-4-carbon (GA, paid tier).
GEMINI_MODEL=gemini-4-carbon
# Models the app may ask for. Anything else is refused with HTTP 400.
GEMINI_ALLOWED_MODELS=gemini-4-carbon,gemini-4-argon,gemini-4-hydrogen,gemini-3.8-flash

# generate_content (default, v1beta/models/{model}:generateContent) or interactions (v1beta/interactions)
GEMINI_API_STYLE=generate_content
# low | medium | high. Carbon ignores temperature/top_p; thinking level is the only knob.
GEMINI_THINKING_LEVEL=medium
GEMINI_MAX_OUTPUT_TOKENS=16384
# Carbon can think for minutes on a large payload.
GEMINI_TIMEOUT_S=900

# Shared secret the iOS app sends as "Authorization: Bearer ...". Generate with: openssl rand -hex 32
PROXY_TOKEN=replace-me
# Only for a local test without a token: PROXY_ALLOW_ANONYMOUS=1 (and leave PROXY_TOKEN empty)
PROXY_ALLOW_ANONYMOUS=0

PROXY_HOST=127.0.0.1
PROXY_PORT=8787
MAX_BODY_BYTES=4194304
# 1 logs the numeric payload (debugging only). Default 0: only ids, status, latency and token counts.
LOG_PAYLOADS=0
