# Clinic engine settings. Copy to .env (git-ignored) and fill in.
# Load before starting:  set -a; . ./.env; set +a
# Placeholders only. Never commit real values.

PRODUCT_NAME=Angel

# Storage: memory | dir | s3
STORE=dir
STORE_DIR=./data
# For STORE=s3 (RustFS or any S3-compatible store)
S3_ENDPOINT_URL=https://objects.example.org
S3_BUCKET=clinic-engine
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_REGION=us-east-1

# HTTP layer
CORS_ORIGINS=
MAX_BODY_BYTES=262144
RATE_PER_MINUTE=120
RATE_BURST=60
SESSION_TTL_MINUTES=120
PAIRING_TTL_HOURS=24

# The mind
DEFAULT_TIMEZONE=Europe/Helsinki
TICK_SECONDS=300
REVIEW_INLINE=false

# Level 1: local model on the private network (OpenAI-compatible API)
LOCAL_LLM_BASE_URL=http://model-host.example.internal:8000/v1
LOCAL_LLM_MODEL=replace-with-model-name
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT_S=8

# Level 2: Gemini, optional. off | gemini
OUTREACH_MODE=off
GEMINI_API_KEY=replace-me
# Placeholder: set the Gemini model id you want to use
GEMINI_MODEL=replace-with-gemini-model-id
GEMINI_TIMEOUT_S=15
READING_IMAGES=true

# Help block (wording in engine/clinic_engine/data/help_block.json, draft)
EMERGENCY_NUMBER=112
CLINIC_CONTACT_LABEL=
CLINIC_CONTACT_PHONE=

# "Needs review" notifier. off | telegram
NOTIFY_MODE=off
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me
CLINICIAN_PAGE_URL=https://clinic.example.org/
NOTIFY_HOURS=08-18
NOTIFY_QUEUE_OUTSIDE_HOURS=true
NOTIFY_MAX_PER_HOUR=10
CLINIC_TIMEZONE=Europe/Helsinki

DEMO_ENABLED=true

# Seed script (python -m clinic_engine.seed). If the password is empty a random one is printed once.
SEED_CLINICIAN_USERNAME=demo-clinician
SEED_CLINICIAN_PASSWORD=

# Who reads a session (activity + face numbers): auto = level 2 when it is on, local = level 1, off
SESSION_READER=auto
