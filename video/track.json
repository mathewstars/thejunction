{
  "sentences": [
    {"start_s": 0.8, "end_s": 2.6, "text": "The clinic door closes behind her."},
    {"start_s": 3.7, "end_s": 5.9, "text": "Her treatment for depression is over."},
    {"start_s": 6.8, "end_s": 10.2, "text": "The next appointment is six weeks away."},
    {"start_s": 11.8, "end_s": 13.0, "text": "On the way home,"},
    {"start_s": 13.7, "end_s": 15.6, "text": "she finds him a fox cub."},
    {"start_s": 16.5, "end_s": 17.6, "text": "Alone in the snow,"},
    {"start_s": 18.4, "end_s": 19.1, "text": "she kneels."},
    {"start_s": 19.8, "end_s": 20.9, "text": "She takes him home."},
    {"start_s": 22.8, "end_s": 24.8, "text": "Every day she does one small thing for him."},
    {"start_s": 25.4, "end_s": 26.6, "text": "She plays with him."},
    {"start_s": 27.5, "end_s": 28.5, "text": "She breathes with him."},
    {"start_s": 29.3, "end_s": 30.1, "text": "At night,"},
    {"start_s": 30.4, "end_s": 32.5, "text": "she tells him three good things for herself."},
    {"start_s": 33.3, "end_s": 34.6, "text": "She would stay in bed."},
    {"start_s": 35.3, "end_s": 35.9, "text": "For him,"},
    {"start_s": 36.4, "end_s": 37.3, "text": "she gets up."},
    {"start_s": 39.1, "end_s": 40.1, "text": "What she doesn't know,"},
    {"start_s": 40.6, "end_s": 42.1, "text": "he is keeping watch over her."},
    {"start_s": 42.8, "end_s": 45.9, "text": "Her phone counts her steps, her smiles, how fast she reacted."},
    {"start_s": 46.8, "end_s": 47.7, "text": "Numbers only."},
    {"start_s": 49.3, "end_s": 50.3, "text": "No pictures."},
    {"start_s": 52.3, "end_s": 54.8, "text": "Every week, the clinic's score."},
    {"start_s": 55.4, "end_s": 56.9, "text": "We put them side-by-side."},
    {"start_s": 58.1, "end_s": 59.3, "text": "When her score rose,"},
    {"start_s": 59.8, "end_s": 61.0, "text": "she smiled less,"},
    {"start_s": 62.0, "end_s": 63.0, "text": "reacted slower,"},
    {"start_s": 63.8, "end_s": 64.6, "text": "walked less."},
    {"start_s": 66.8, "end_s": 67.2, "text": "Then,"},
    {"start_s": 67.8, "end_s": 68.7, "text": "November."},
    {"start_s": 70.4, "end_s": 73.0, "text": "The lines turn red, boots stay by the door."},
    {"start_s": 74.3, "end_s": 75.3, "text": "At 1:00 a.m.,"},
    {"start_s": 76.1, "end_s": 76.8, "text": "she writes,"},
    {"start_s": 77.8, "end_s": 78.8, "text": "\"I need help.\""},
    {"start_s": 80.8, "end_s": 81.6, "text": "That night,"},
    {"start_s": 82.2, "end_s": 84.1, "text": "her clinician's phone lights up."},
    {"start_s": 86.4, "end_s": 86.9, "text": "Hannah"},
    {"start_s": 87.8, "end_s": 88.8, "text": "is an example."},
    {"start_s": 90.0, "end_s": 91.1, "text": "Nobody knows yet"},
    {"start_s": 92.2, "end_s": 94.0, "text": "whether a phone can truly see this."},
    {"start_s": 96.6, "end_s": 99.0, "text": "That is the study we want to run."},
    {"start_s": 101.4, "end_s": 103.5, "text": "She thought she was saving a fox."},
    {"start_s": 105.1, "end_s": 107.1, "text": "He kept the light on for her."}
  ]
}
